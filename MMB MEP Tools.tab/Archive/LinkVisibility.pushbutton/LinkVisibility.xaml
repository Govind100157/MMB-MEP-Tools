<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Link Visibility Manager"
    Height="700"
    Width="900"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Links -->

        <GroupBox Header="Visible Links"
                  Grid.Column="0"
                  Margin="5">

            <DockPanel>

                <Button Name="btnSelectAllLinks"
                        Content="Select All Links"
                        Height="30"
                        DockPanel.Dock="Top"/>

                <ListBox Name="lstLinks"
                         SelectionMode="Extended"/>

            </DockPanel>

        </GroupBox>

        <!-- Views -->

        <GroupBox Header="Views"
                  Grid.Column="1"
                  Margin="5">

            <DockPanel>

                <Button Name="btnSelectAllViews"
                        Content="Select All Views"
                        Height="30"
                        DockPanel.Dock="Top"/>

                <ListBox Name="lstViews"
                         SelectionMode="Extended"/>

            </DockPanel>

        </GroupBox>

        <Button Name="btnApply"
                Content="Apply"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,10"/>

    </Grid>

</Window>
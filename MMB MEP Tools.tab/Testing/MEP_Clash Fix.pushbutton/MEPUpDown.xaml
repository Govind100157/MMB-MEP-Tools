<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MEP Clash Fix"
    Width="600"
    Height="515"
    MinWidth="600"
    MinHeight="515"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="NormalTextBrush" Color="#444444"/>
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#90EE90"/>

        <Style x:Key="ValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#9E9E9E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MovementButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#6F6F6F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AngleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="67"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border
        Margin="10"
        Padding="16"
        Background="White"
        BorderBrush="#D2D2D2"
        BorderThickness="1"
        CornerRadius="4">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="76"/>
                <RowDefinition Height="27"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Main movement mode -->
            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

                <Button
                    x:Name="up_down_button"
                    Content="Up / Down Offset"
                    Style="{StaticResource MovementButtonStyle}"
                    Click="movement_up_down_click"
                    ToolTip="Use positive offset for Up and negative offset for Down."/>

                <Button
                    x:Name="left_right_button"
                    Content="Side Offset"
                    Style="{StaticResource MovementButtonStyle}"
                    Click="movement_left_right_click"
                    ToolTip="Positive and negative values offset the selected group to either side. Use the preview to choose the desired side."/>
            </StackPanel>

            <!-- One-point / two-point mode -->
            <GroupBox
                Grid.Row="1"
                Header="Offset Mode"
                Margin="0,0,0,5">

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10,5">

                    <RadioButton
                        x:Name="two_point_mode"
                        Content="Two Transitions"
                        GroupName="OffsetMode"
                        IsChecked="True"
                        Margin="0,0,35,0"
                        VerticalAlignment="Center"
                        Checked="offset_mode_changed"
                        ToolTip="Split twice and select each middle section or connected middle group."/>

                    <RadioButton
                        x:Name="one_point_mode"
                        Content="One Transition"
                        GroupName="OffsetMode"
                        VerticalAlignment="Center"
                        Checked="offset_mode_changed"
                        ToolTip="Split once and select each side that must move."/>
                </StackPanel>
            </GroupBox>

            <TextBlock
                Grid.Row="2"
                Text="Offset"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Bottom"/>

            <!-- Signed offset slider -->
            <Grid Grid.Row="3" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        x:Name="negative_direction_label"
                        Text="Down"
                        HorizontalAlignment="Center"
                        Foreground="#666666"
                        FontSize="11"
                        Margin="0,0,0,3"/>
                    <TextBox
                        x:Name="negative_offset_box"
                        Style="{StaticResource ValueTextBoxStyle}"
                        TextChanged="negative_offset_text_changed"
                        ToolTip="Enter the negative-direction offset magnitude."/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        x:Name="current_offset_text"
                        Text="0"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#0078D4"/>

                    <Slider
                        x:Name="offset_slider"
                        Grid.Row="1"
                        Minimum="-10000"
                        Maximum="10000"
                        Value="0"
                        SmallChange="50"
                        LargeChange="500"
                        TickFrequency="100"
                        IsSnapToTickEnabled="False"
                        IsMoveToPointEnabled="True"
                        ValueChanged="offset_slider_value_changed"
                        PreviewMouseLeftButtonUp="offset_slider_mouse_up"
                        VerticalAlignment="Center"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Negative" HorizontalAlignment="Left" Foreground="#777777" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="0" HorizontalAlignment="Center" Foreground="#777777" FontSize="10"/>
                        <TextBlock Grid.Column="2" Text="Positive" HorizontalAlignment="Right" Foreground="#777777" FontSize="10"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        x:Name="positive_direction_label"
                        Text="Up"
                        HorizontalAlignment="Center"
                        Foreground="#666666"
                        FontSize="11"
                        Margin="0,0,0,3"/>
                    <TextBox
                        x:Name="positive_offset_box"
                        Style="{StaticResource ValueTextBoxStyle}"
                        TextChanged="positive_offset_text_changed"
                        ToolTip="Enter the positive-direction offset magnitude."/>
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="4"
                Text="Transition Angle"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Bottom"/>

            <!-- Angle presets and custom angle -->
            <Grid Grid.Row="5" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="angle_30_button" Grid.Column="0" Content="30 deg" Tag="30" Style="{StaticResource AngleButtonStyle}" Click="angle_preset_click"/>
                <Button x:Name="angle_45_button" Grid.Column="1" Content="45 deg" Tag="45" Style="{StaticResource AngleButtonStyle}" Click="angle_preset_click"/>
                <Button x:Name="angle_60_button" Grid.Column="2" Content="60 deg" Tag="60" Style="{StaticResource AngleButtonStyle}" Click="angle_preset_click"/>
                <Button x:Name="angle_90_button" Grid.Column="3" Content="90 deg" Tag="90" Style="{StaticResource AngleButtonStyle}" Click="angle_preset_click"/>

                <TextBox
                    x:Name="angle_box"
                    Grid.Column="5"
                    Style="{StaticResource ValueTextBoxStyle}"
                    TextChanged="angle_text_changed"
                    ToolTip="Enter any angle greater than 0 and up to 90 degrees."/>

                <TextBlock
                    Grid.Column="6"
                    Margin="8,0,0,0"
                    Text="Custom angle"
                    Foreground="#666666"
                    VerticalAlignment="Center"/>
            </Grid>

            <!-- Preview information -->
            <Border
                Grid.Row="6"
                Margin="0,6,0,0"
                Padding="8,5"
                Background="#EAF4FC"
                BorderBrush="#B7D9F2"
                BorderThickness="1"
                CornerRadius="3">
                <TextBlock
                    x:Name="preview_text"
                    Text="Select MEP elements, adjust the offset and review the cyan preview."
                    TextWrapping="Wrap"
                    Foreground="#245A7A"
                    VerticalAlignment="Center"
                    FontSize="11"/>
            </Border>

            <!-- Status -->
            <Border
                Grid.Row="7"
                Margin="0,7,0,0"
                Padding="8,5"
                Background="#F6F6F6"
                BorderBrush="#E2E2E2"
                BorderThickness="1"
                CornerRadius="3">
                <TextBlock
                    x:Name="status"
                    Text="Choose a movement mode, split the MEP runs, select the sections and click Apply."
                    TextWrapping="Wrap"
                    Foreground="{StaticResource NormalTextBrush}"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- Actions -->
            <StackPanel
                Grid.Row="8"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Button
                    x:Name="close_button"
                    Content="Close"
                    Width="82"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="close_click"/>
                <Button
                    x:Name="apply_button"
                    Content="Apply"
                    Width="104"
                    Height="30"
                    Click="apply_click"
                    IsDefault="True"
                    Background="#DCEEFF"
                    BorderBrush="#4987C5"
                    FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MEP Up/Down"
    Width="560"
    Height="500"
    MinWidth="560"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    Background="#F5F5F5">

    <Window.Resources>

        <SolidColorBrush
            x:Key="NormalTextBrush"
            Color="#444444"/>

        <SolidColorBrush
            x:Key="ErrorTextBrush"
            Color="#C62828"/>

        <SolidColorBrush
            x:Key="SuccessTextBrush"
            Color="#2E7D32"/>

        <Style
            x:Key="ValueTextBoxStyle"
            TargetType="TextBox">

            <Setter
                Property="Height"
                Value="28"/>

            <Setter
                Property="Padding"
                Value="4,1"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="BorderBrush"
                Value="#9E9E9E"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

        </Style>

        <Style
            x:Key="AngleButtonStyle"
            TargetType="Button">

            <Setter
                Property="Width"
                Value="64"/>

            <Setter
                Property="Height"
                Value="30"/>

            <Setter
                Property="Margin"
                Value="0,0,8,0"/>

            <Setter
                Property="Background"
                Value="#F7F7F7"/>

            <Setter
                Property="BorderBrush"
                Value="#999999"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>

    </Window.Resources>

    <Border
        Margin="10"
        Padding="16"
        Background="White"
        BorderBrush="#D2D2D2"
        BorderThickness="1"
        CornerRadius="4">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
				<RowDefinition Height="28"/>
                <RowDefinition Height="72"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>
			
			<!-- =================================================
				 OFFSET MODE
				 ================================================= -->

			<GroupBox
				Grid.Row="0"
				Grid.ColumnSpan="3"
				Header="Offset Mode"
				Margin="0,0,0,8">

				<StackPanel
					Orientation="Horizontal"
					Margin="10,5">

					<RadioButton
						x:Name="two_point_mode"
						Content="Two Point"
						GroupName="OffsetMode"
						IsChecked="True"
						Margin="0,0,25,0"
						VerticalAlignment="Center"
						Checked="offset_mode_changed"
						ToolTip="Split twice and select the middle section."/>

					<RadioButton
						x:Name="one_point_mode"
						Content="One Point"
						GroupName="OffsetMode"
						VerticalAlignment="Center"
						Checked="offset_mode_changed"
						ToolTip="Split once and select the side that must move."/>

				</StackPanel>

			</GroupBox>

            <!-- =================================================
                 OFFSET HEADING
                 ================================================= -->

            <TextBlock
                Grid.Row="1"
                Text="Offset"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Top"/>

            <!-- =================================================
                 OFFSET SLIDER AND MANUAL BOXES
                 ================================================= -->

            <Grid
                Grid.Row="2"
                Margin="0,4,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>

                <!-- Negative manual offset -->

                <StackPanel
                    Grid.Column="0">

                    <TextBlock
                        Text="Down"
                        HorizontalAlignment="Center"
                        Foreground="#666666"
                        FontSize="11"
                        Margin="0,0,0,3"/>

                    <TextBox
                        x:Name="negative_offset_box"
                        Style="{StaticResource ValueTextBoxStyle}"
                        TextChanged="negative_offset_text_changed"
                        ToolTip="Enter the downward offset magnitude"/>

                </StackPanel>

                <!-- Slider -->

                <Grid
                    Grid.Column="1"
                    Margin="12,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        x:Name="current_offset_text"
                        Text="0"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#0078D4"/>

                    <Slider
                        x:Name="offset_slider"
                        Grid.Row="1"
                        Minimum="-10000"
                        Maximum="10000"
                        Value="0"
                        SmallChange="50"
                        LargeChange="500"
                        TickFrequency="100"
                        IsSnapToTickEnabled="False"
                        IsMoveToPointEnabled="True"
                        ValueChanged="offset_slider_value_changed"
                        PreviewMouseLeftButtonUp="offset_slider_mouse_up"
                        VerticalAlignment="Center"
                        ToolTip="Move left for Down or right for Up"/>

                    <Grid
                        Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Negative"
                            HorizontalAlignment="Left"
                            Foreground="#777777"
                            FontSize="10"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="0"
                            HorizontalAlignment="Center"
                            Foreground="#777777"
                            FontSize="10"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Positive"
                            HorizontalAlignment="Right"
                            Foreground="#777777"
                            FontSize="10"/>

                    </Grid>

                </Grid>

                <!-- Positive manual offset -->

                <StackPanel
                    Grid.Column="2">

                    <TextBlock
                        Text="Up"
                        HorizontalAlignment="Center"
                        Foreground="#666666"
                        FontSize="11"
                        Margin="0,0,0,3"/>

                    <TextBox
                        x:Name="positive_offset_box"
                        Style="{StaticResource ValueTextBoxStyle}"
                        TextChanged="positive_offset_text_changed"
                        ToolTip="Enter the upward offset magnitude"/>

                </StackPanel>

            </Grid>

            <!-- =================================================
                 ANGLE HEADING
                 ================================================= -->

            <TextBlock
                Grid.Row="3"
                Text="Transition angle"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Bottom"/>

            <!-- =================================================
                 ANGLE PRESETS
                 ================================================= -->

            <Grid
                Grid.Row="4"
                Margin="0,5,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="angle_30_button"
                    Grid.Column="0"
                    Content="30°"
                    Tag="30"
                    Style="{StaticResource AngleButtonStyle}"
                    Click="angle_preset_click"/>

                <Button
                    x:Name="angle_45_button"
                    Grid.Column="1"
                    Content="45°"
                    Tag="45"
                    Style="{StaticResource AngleButtonStyle}"
                    Click="angle_preset_click"/>

                <Button
                    x:Name="angle_60_button"
                    Grid.Column="2"
                    Content="60°"
                    Tag="60"
                    Style="{StaticResource AngleButtonStyle}"
                    Click="angle_preset_click"/>

                <Button
                    x:Name="angle_90_button"
                    Grid.Column="3"
                    Content="90°"
                    Tag="90"
                    Style="{StaticResource AngleButtonStyle}"
                    Click="angle_preset_click"/>

                <TextBox
                    x:Name="angle_box"
                    Grid.Column="5"
                    Style="{StaticResource ValueTextBoxStyle}"
                    TextChanged="angle_text_changed"
                    ToolTip="Enter any angle greater than 0 and up to 90 degrees"/>

                <TextBlock
                    Grid.Column="6"
                    Margin="8,0,0,0"
                    Text="Custom angle"
                    Foreground="#666666"
                    VerticalAlignment="Center"/>

            </Grid>

            <!-- =================================================
                 PREVIEW INFORMATION
                 ================================================= -->

            <Border
                Grid.Row="5"
                Margin="0,6,0,0"
                Padding="8,5"
                Background="#EAF4FC"
                BorderBrush="#B7D9F2"
                BorderThickness="1"
                CornerRadius="3">

                <TextBlock
                    x:Name="preview_text"
                    Text="Select split MEP sections. Move the slider or enter a value to calculate the preview."
                    TextWrapping="Wrap"
                    Foreground="#245A7A"
                    VerticalAlignment="Center"
                    FontSize="11"/>

            </Border>

            <!-- =================================================
                 STATUS
                 ================================================= -->

            <Border
                Grid.Row="6"
                Margin="0,7,0,0"
                Padding="8,5"
                Background="#F6F6F6"
                BorderBrush="#E2E2E2"
                BorderThickness="1"
                CornerRadius="3">

                <TextBlock
                    x:Name="status"
                    Text="Split and select MEP elements in Revit, then click Apply."
                    TextWrapping="Wrap"
                    Foreground="{StaticResource NormalTextBrush}"
                    VerticalAlignment="Center"/>

            </Border>

            <!-- =================================================
                 BUTTONS
                 ================================================= -->

            <StackPanel
                Grid.Row="7"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">

                <Button
                    x:Name="close_button"
                    Content="Close"
                    Width="82"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="close_click"/>

                <Button
                    x:Name="apply_button"
                    Content="Apply"
                    Width="104"
                    Height="30"
                    Click="apply_click"
                    IsDefault="True"
                    Background="#DCEEFF"
                    BorderBrush="#4987C5"
                    FontWeight="SemiBold"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
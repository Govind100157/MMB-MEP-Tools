<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MEP Up/Down"
    Height="220"
    Width="370"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Text="Offset:"
            VerticalAlignment="Center"/>

        <TextBox
            x:Name="offset_box"
            Grid.Row="0"
            Grid.Column="1"
            Height="24"
            VerticalContentAlignment="Center"/>

        <TextBlock
            Grid.Row="0"
            Grid.Column="2"
            Margin="8,0,0,0"
            Text="Project length unit"
            Foreground="#666666"
            VerticalAlignment="Center"/>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="Angle:"
            VerticalAlignment="Center"/>

        <TextBox
            x:Name="angle_box"
            Grid.Row="1"
            Grid.Column="1"
            Height="24"
            VerticalContentAlignment="Center"/>

        <TextBlock
            Grid.Row="1"
            Grid.Column="2"
            Margin="8,0,0,0"
            Text="1–90 degrees"
            Foreground="#666666"
            VerticalAlignment="Center"/>

        <TextBlock
            x:Name="status"
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Text="Split and select MEP elements in Revit, then click Apply."
            TextWrapping="Wrap"
            Foreground="#444444"
            VerticalAlignment="Center"/>

        <StackPanel
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Close"
                Width="70"
                Height="28"
                Margin="0,0,8,0"
                Click="close_click"/>

            <Button
                Content="Apply"
                Width="90"
                Height="28"
                Click="apply_click"
                IsDefault="True"
                Background="#DCEEFF"/>

        </StackPanel>

    </Grid>

</Window>